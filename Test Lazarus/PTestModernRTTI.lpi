      </Unit>
      <Unit>
        <Filename Value="..\Source\ModernSyntax.RTTI.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="ModernSyntax.RTTI"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
