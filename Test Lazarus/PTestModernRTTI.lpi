      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="PTestModernRTTI"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <Units>
      <Unit>
        <Filename Value="PTestModernRTTI.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\Test Delphi\EclbrSystem\UTestMS.RTTI.pas"/>
